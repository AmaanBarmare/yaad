# Paytm Inference — Claude Opus 4.5 (vision)
PI_API_KEY=your_paytm_inference_api_key
PI_BASE_URL=https://api.inference.paytm.com
# Vision model id (see GET /v1/models). Target "Claude Opus 4.5" 422s upstream
# until Paytm attaches an inference profile; llama-4-scout serves vision today.
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Sarvam AI — message gen (Sarvam 30B) + Bulbul V3 TTS
SARVAM_API_KEY=your_sarvam_api_key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase Storage bucket for voice note audio
SUPABASE_AUDIO_BUCKET=voice-notes

# Scheduler — daily reminder run time (24h, local server time)
REMINDER_CRON_HOUR=10
REMINDER_CRON_MINUTE=0

# CORS — frontend origin
FRONTEND_ORIGIN=http://localhost:5173
